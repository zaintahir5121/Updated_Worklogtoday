@model LoginViewModel
@{
    ViewData["Title"] = "Sign in · worklog.today";
    ViewData["Description"] = "Sign in to worklog.today.";
    var googleEnabled = ViewData["GoogleEnabled"] as bool? == true;
}
<div class="auth-wrap">
    <aside class="auth-aside">
        <a class="logo" href="/" style="color:#fff"><span class="mark"><i class="bi bi-journal-text"></i></span>worklog<span style="color:var(--amber)">.today</span></a>
        <div>
            <h2>Welcome back. Your work, perfectly captured.</h2>
            <p>Pick up right where you left off — notes, daily tasks, and a timesheet that's already done.</p>
            <div class="pts">
                <div><i class="bi bi-check-circle-fill"></i> Keep-style notes board</div>
                <div><i class="bi bi-check-circle-fill"></i> One-click AI weekly summary</div>
                <div><i class="bi bi-check-circle-fill"></i> Timesheets ready to submit</div>
            </div>
        </div>
        <div style="color:#94a3b8;font-size:13px">Trusted by professionals who hate timesheet day.</div>
    </aside>
    <main class="auth-main">
        <div class="auth-card">
            <h1>Sign in</h1>
            <p class="muted">Enter your details to access your workspace.</p>

            @if (googleEnabled)
            {
                <form asp-action="ExternalLogin" asp-controller="Account" method="post" style="margin-bottom:16px">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="Google" />
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <button type="submit" class="btn-google">
                        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                            <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908C16.658 14.013 17.64 11.706 17.64 9.2z"/>
                            <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
                            <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
                            <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58z"/>
                        </svg>
                        Continue with Google
                    </button>
                </form>
                <div class="or-sep"><span>or sign in with email</span></div>
            }

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="val-err"></div>
                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="input" placeholder="you@company.com" autofocus />
                    <span asp-validation-for="Email" class="val-err"></span>
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="input" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="val-err"></span>
                </div>
                <div class="field" style="display:flex;align-items:center;gap:8px">
                    <input asp-for="RememberMe" type="checkbox" style="width:16px;height:16px" />
                    <label asp-for="RememberMe" style="margin:0"></label>
                </div>
                <button type="submit" class="btn btn-amber" style="width:100%;justify-content:center"><i class="bi bi-box-arrow-in-right"></i> Sign in</button>
            </form>
            <p class="muted" style="margin-top:18px;text-align:center">New here? <a asp-action="Register" style="color:var(--amber-2);font-weight:600;text-decoration:none">Create an account</a></p>
            <p class="muted" style="margin-top:12px;text-align:center;font-size:12px">By signing in you agree to our <a href="/terms" style="color:var(--muted);text-decoration:underline">Terms</a> and <a href="/privacy" style="color:var(--muted);text-decoration:underline">Privacy Policy</a>.</p>
        </div>
    </main>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
