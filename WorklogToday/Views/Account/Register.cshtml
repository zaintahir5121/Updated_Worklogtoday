@model RegisterViewModel
@{
    ViewData["Title"] = "Create your account · worklog.today";
    ViewData["Description"] = "Create a free worklog.today account.";
    var googleEnabled = ViewData["GoogleEnabled"] as bool? == true;
}
<div class="auth-wrap">
    <aside class="auth-aside">
        <a class="logo" href="/" style="color:#fff"><span class="mark"><i class="bi bi-journal-text"></i></span>worklog<span style="color:var(--amber)">.today</span></a>
        <div>
            <h2>Start capturing your work in seconds.</h2>
            <p>Free to start. No credit card. Your notes, tasks and timesheets — all in one calm, fast workspace.</p>
            <div class="pts">
                <div><i class="bi bi-check-circle-fill"></i> Unlimited notes &amp; tasks</div>
                <div><i class="bi bi-check-circle-fill"></i> Automatic weekly timesheets</div>
                <div><i class="bi bi-check-circle-fill"></i> AI summaries &amp; reports</div>
            </div>
        </div>
        <div style="color:#94a3b8;font-size:13px">It takes less than a minute.</div>
    </aside>
    <main class="auth-main">
        <div class="auth-card">
            <h1>Create account</h1>
            <p class="muted">Your personal work workspace, ready in seconds.</p>

            @if (googleEnabled)
            {
                <form asp-action="ExternalLogin" asp-controller="Account" method="post" style="margin-bottom:16px">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="Google" />
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <button type="submit" class="btn-google">
                        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                            <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908C16.658 14.013 17.64 11.706 17.64 9.2z"/>
                            <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
                            <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
                            <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58z"/>
                        </svg>
                        Sign up with Google
                    </button>
                </form>
                <div class="or-sep"><span>or sign up with email</span></div>
            }

            <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="val-err"></div>
                <div class="field">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" class="input" placeholder="Alex Rivera" autofocus />
                    <span asp-validation-for="FullName" class="val-err"></span>
                </div>
                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="input" placeholder="you@company.com" />
                    <span asp-validation-for="Email" class="val-err"></span>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label asp-for="JobTitle"></label>
                        <input asp-for="JobTitle" class="input" placeholder="Engineer" />
                    </div>
                    <div class="field">
                        <label asp-for="Company"></label>
                        <input asp-for="Company" class="input" placeholder="Acme Corp" />
                    </div>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="input" placeholder="6+ characters" />
                        <span asp-validation-for="Password" class="val-err"></span>
                    </div>
                    <div class="field">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" class="input" placeholder="Repeat" />
                        <span asp-validation-for="ConfirmPassword" class="val-err"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-amber" style="width:100%;justify-content:center"><i class="bi bi-rocket-takeoff"></i> Create my account</button>
            </form>
            <p class="muted" style="margin-top:18px;text-align:center">Already have an account? <a asp-action="Login" style="color:var(--amber-2);font-weight:600;text-decoration:none">Sign in</a></p>
            <p class="muted" style="margin-top:12px;text-align:center;font-size:12px">By creating an account you agree to our <a href="/terms" style="color:var(--muted);text-decoration:underline">Terms of Service</a> and <a href="/privacy" style="color:var(--muted);text-decoration:underline">Privacy Policy</a>.</p>
        </div>
    </main>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
